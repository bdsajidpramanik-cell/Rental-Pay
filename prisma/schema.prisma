datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  VIEWER
  TENANT
}

enum ShopStatus {
  VACANT
  OCCUPIED
  RESERVED
  INACTIVE
}

enum AgreementStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  ARCHIVED
}

enum BillStatus {
  DRAFT
  ISSUED
  PENDING
  PROOF_SUBMITTED
  UNDER_REVIEW
  PAID
  OVERDUE
  REJECTED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  ONLINE
  BANK
  ELECTRICITY_OFFICE
  CASH
}

enum ProofVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  email             String               @unique
  phoneNumber       String?              @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              Role                 @default(VIEWER)
  isActive          Boolean              @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  ownedProperties   Property[]           @relation("PropertyOwner")
  tenants           Tenant[]
  createdAgreements Agreement[]          @relation("AgreementCreator")
  recordedPayments  Payment[]            @relation("PaymentRecorder")
  createdQrTokens   QrOnboardingToken[]  @relation("TokenCreator")
  auditLogs         AuditLog[]
  verifiedProofs    PaymentProof[]       @relation("ProofVerifier")
  agreementVersions AgreementVersion[]  @relation("VersionAuthor")

  @@index([email])
  @@index([role, isActive])
}

model Property {
  id        String              @id @default(uuid()) @db.Uuid
  name      String
  code      String              @unique
  address   String?
  city      String?
  ownerId   String              @db.Uuid
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  owner     User                @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  shops     Shop[]
  tenants   Tenant[]
  agreements Agreement[]
  bills     Bill[]
  payments  Payment[]
  receipts  Receipt[]
  qrTokens  QrOnboardingToken[]

  @@index([ownerId])
  @@index([code])
}

model Shop {
  id         String              @id @default(uuid()) @db.Uuid
  propertyId String              @db.Uuid
  shopNumber String
  floor      String?
  sizeSqFt   Float?
  rentAmount Decimal             @db.Decimal(12, 2)
  status     ShopStatus          @default(VACANT)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants    Tenant[]
  agreements Agreement[]
  bills      Bill[]
  payments   Payment[]
  receipts   Receipt[]
  qrTokens   QrOnboardingToken[]

  @@unique([propertyId, shopNumber])
  @@index([propertyId, status])
}

model Tenant {
  id               String      @id @default(uuid()) @db.Uuid
  propertyId       String      @db.Uuid
  shopId           String      @db.Uuid
  userId           String      @db.Uuid
  businessName     String
  emergencyContact String
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  property         Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  shop             Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  agreements       Agreement[]
  bills            Bill[]
  payments         Payment[]

  @@index([propertyId, shopId])
  @@index([userId])
}

model Agreement {
  id              String             @id @default(uuid()) @db.Uuid
  propertyId      String             @db.Uuid
  shopId          String             @db.Uuid
  tenantId        String             @db.Uuid
  createdById     String             @db.Uuid
  agreementNumber String             @unique
  status          AgreementStatus    @default(DRAFT)
  startDate       DateTime
  endDate         DateTime
  rentAmount      Decimal            @db.Decimal(12, 2)
  securityDeposit Decimal            @db.Decimal(12, 2)
  termsJson       Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy       User               @relation("AgreementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions        AgreementVersion[]
  bills           Bill[]

  @@index([propertyId, shopId])
  @@index([status])
}

model AgreementVersion {
  id             String    @id @default(uuid()) @db.Uuid
  agreementId    String    @db.Uuid
  versionNumber  Int
  revisionReason String
  changedById    String    @db.Uuid
  snapshotData   Json
  createdAt      DateTime  @default(now())
  agreement      Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  changedBy      User      @relation("VersionAuthor", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([agreementId, versionNumber])
  @@index([agreementId])
}

model Bill {
  id            String        @id @default(uuid()) @db.Uuid
  propertyId    String        @db.Uuid
  shopId        String        @db.Uuid
  tenantId      String        @db.Uuid
  agreementId   String        @db.Uuid
  billNumber    String        @unique
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime
  rentAmount    Decimal       @default(0) @db.Decimal(12, 2)
  utilityAmount Decimal       @default(0) @db.Decimal(12, 2)
  penaltyAmount Decimal       @default(0) @db.Decimal(12, 2)
  amount        Decimal       @db.Decimal(12, 2)
  status        BillStatus    @default(ISSUED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agreement     Agreement     @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  payments      Payment[]

  @@index([propertyId, shopId])
  @@index([status, dueDate])
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  propertyId      String        @db.Uuid
  shopId          String        @db.Uuid
  billId          String        @db.Uuid
  tenantId        String        @db.Uuid
  recordedById    String        @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  bill            Bill          @relation(fields: [billId], references: [id], onDelete: Restrict)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordedBy      User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  paymentProof    PaymentProof?
  receipt         Receipt?

  @@index([propertyId, shopId])
  @@index([billId])
}

model PaymentProof {
  id                 String                  @id @default(uuid()) @db.Uuid
  paymentId          String                  @unique @db.Uuid
  fileUrl            String
  fileType           String
  verificationStatus ProofVerificationStatus @default(PENDING)
  verifiedById       String?                 @db.Uuid
  verifiedAt         DateTime?
  rejectionReason    String?
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  payment            Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  verifiedBy         User?                   @relation("ProofVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  propertyId    String   @db.Uuid
  shopId        String   @db.Uuid
  paymentId     String   @unique @db.Uuid
  receiptNumber String   @unique
  issuedAt      DateTime @default(now())
  amount        Decimal  @db.Decimal(12, 2)
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([propertyId, shopId])
}

model QrOnboardingToken {
  id            String    @id @default(uuid()) @db.Uuid
  propertyId    String    @db.Uuid
  shopId        String    @db.Uuid
  tokenHash     String    @unique
  attemptsCount Int       @default(0)
  maxAttempts   Int       @default(2)
  isConsumed    Boolean   @default(false)
  consumedAt    DateTime?
  expiresAt     DateTime
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("TokenCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([propertyId, shopId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  details    Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
